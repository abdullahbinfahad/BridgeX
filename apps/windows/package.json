{
  "name": "bridgex-windows",
  "version": "1.0.0",
  "private": true,
  "description": "BridgeX Windows desktop marketplace wrapper",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "package:windows": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "im.bridgex.marketplace.windows",
    "productName": "BridgeX",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "dir"
      ]
    }
  }
}

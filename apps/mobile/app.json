{
  "expo": {
    "name": "BridgeX",
    "slug": "bridgex",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "bridgex",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "im.bridgex.marketplace"
    },
    "android": {
      "package": "im.bridgex.marketplace",
      "versionCode": 15,
      "navigationBarColor": "#f7f5ef",
      "statusBarColor": "#f7f5ef",
      "statusBarStyle": "dark-content",
      "adaptiveIcon": {
        "backgroundColor": "#f7f5ef",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "predictiveBackGestureEnabled": false
    },
    "softwareKeyboardLayoutMode": "resize",
    "extra": {
      "eas": {
        "projectId": "459e7ae1-9dc7-4318-b642-814abe9ace20"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BridgeX to select delivery, verification, and payment evidence when you choose to upload it.",
          "cameraPermission": "Allow BridgeX to take a photo when you choose to upload delivery, verification, or payment evidence.",
          "microphonePermission": false
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "owner": "abdullahbinfahadbridexs-team"
  }
}

{
  "expo": {
    "name": "BridgeX",
    "slug": "bridgex",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "bridgex",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "im.bridgex.marketplace"
    },
    "android": {
      "package": "im.bridgex.marketplace",
      "versionCode": 13,
      "adaptiveIcon": {
        "backgroundColor": "#f7f5ef",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "INTERNET",
        "POST_NOTIFICATIONS",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "predictiveBackGestureEnabled": false
    },
    "softwareKeyboardLayoutMode": "resize",
    "extra": {
      "eas": {
        "projectId": "79a0cf5c-1667-471c-a9fd-4c79444363f8"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BridgeX to select delivery, verification, and payment evidence when you choose to upload it.",
          "cameraPermission": "Allow BridgeX to take a photo when you choose to upload delivery, verification, or payment evidence.",
          "microphonePermission": false
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "owner": "abdullahbinfahadabfs-team"
  }
}

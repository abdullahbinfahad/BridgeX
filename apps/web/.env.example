# Required production server settings
NODE_ENV=production
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
JWT_SECRET=replace-with-a-long-random-secret

# Configure an OAuth provider that allows https://bridgex.abdullahbinfahad.info
OAUTH_SERVER_URL=https://YOUR-AUTH-SERVICE
VITE_APP_ID=YOUR_APP_ID
VITE_OAUTH_PORTAL_URL=https://YOUR-AUTH-PORTAL

# Optional BridgeX service integrations. Do not commit real values.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

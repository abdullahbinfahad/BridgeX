#v(0.22em)
#text(font: "DejaVu Sans Mono", size: 6.85pt)[apps/web/client/src/App.tsx · pages/Marketplace.tsx · components/bridgex/PublicLayout.tsx · pages/Workspace.tsx · pages/AdminControl.tsx]
#v(0.28em)
